      "@deepseek-ai/schemastery": ["G:/deepseek-harness/vendor/schemastery"],
      "@deepseek-ai/dsh-tools": ["G:/deepseek-harness/packages/core/tools"],
      "@deepseek-ai/dsh-host-webserver": ["G:/deepseek-harness/packages/host/webserver"]
    },
    "types": ["node"]
  },
  "include": ["src/node/**/*.ts"]
}